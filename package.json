{
  "name": "faultline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Code impact analysis meets a local distributed systems wind tunnel.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/server/src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "demo:reset": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12"
  }
}
