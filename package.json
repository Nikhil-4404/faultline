{
  "name": "faultline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Code impact analysis meets a local distributed systems wind tunnel.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "node scripts/runtime.mjs --import tsx scripts/dev.ts",
    "dev:server": "node scripts/runtime.mjs node_modules/tsx/dist/cli.mjs watch apps/server/src/index.ts",
    "build": "node scripts/runtime.mjs node_modules/typescript/bin/tsc --noEmit && node scripts/runtime.mjs node_modules/vite/bin/vite.js build",
    "start": "node scripts/runtime.mjs --import tsx apps/server/src/index.ts",
    "test": "node scripts/runtime.mjs node_modules/tsx/dist/cli.mjs --test tests/*.test.ts",
    "check": "node scripts/runtime.mjs node_modules/typescript/bin/tsc --noEmit",
    "demo:reset": "node scripts/runtime.mjs --import tsx scripts/demo.ts",
    "setup:runtime": "pwsh -NoProfile -File scripts/setup-runtime.ps1",
    "runtime:check": "node scripts/runtime.mjs --version"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12"
  }
}
